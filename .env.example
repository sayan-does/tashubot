# =============================================================================
# TashuBot Environment Configuration
# Copy this file to .env and populate with your own API credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Telegram Bot Gateway (Required for Telegram bot)
# -----------------------------------------------------------------------------
# Obtain free from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_12345678

# -----------------------------------------------------------------------------
# 2. LLM Inference Providers & Cascading Routers (Configure at least one)
# -----------------------------------------------------------------------------
# Groq LPU (Ultra-fast 500-800 tok/s inference, 14.4k req/day free) - https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# GitHub Models (Free GPT-4o-mini & DeepSeek-R1 inference via GitHub PAT) - https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=ghp_...
# Alternative GitHub token (also used for repository and profile exploration tools)
GITHUB_TOKEN=ghp_...

# Mistral AI (Free tier Mistral-Small inference) - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=...

# Google AI Studio (Free Gemini 2.5 Flash inference & audio processing) - https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# OpenRouter (Aggregated free models: Hermes, Llama, Qwen) - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# 3. Google Workspace MCP Integration (Drive, Calendar, Gmail, Tasks)
# -----------------------------------------------------------------------------
# Run `python scripts/setup_google_mcp.py` to automatically authenticate and generate these:
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//04...
# Optional: Target specific Google Drive folder ID (leave blank to search all Drive files)
GDRIVE_FOLDER_ID=

# Alternative: Service Account JSON string for Google Cloud headless authentication
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# 4. Hugging Face Space CI/CD Deployment (GitHub Actions)
# -----------------------------------------------------------------------------
# Required if using .github/workflows/sync_to_hf.yml
HF_TOKEN=hf_...
HF_USERNAME=your-hf-username
HF_SPACE_NAME=TashuBot
